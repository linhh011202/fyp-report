graph TB
    subgraph "User Interface"
        PAGES["📄 Pages / Views<br/>(SignIn, Dashboard, Subscription, Users)"]
        COMP["🧩 Reusable Components<br/>(PlanCard, Navigation, Snackbar)"]
    end

    subgraph "Application Logic"
        ROUTER["🔀 Vue Router 4<br/>Navigation Guards<br/>(ensureSession, ensureSignedIn)"]
        COMPOSE["🔗 Composables<br/>(useAuth, useGlobalState)"]
        STATE["📦 Global State<br/>(Provide/Inject Pattern)"]
    end

    subgraph "Data Access"
        SERVICES["📡 Service Layer<br/>(AuthService, StripeService, PlanService)"]
        HTTP["🌐 Axios HTTP Client<br/>Token Injection & Auto-Refresh"]
    end

    subgraph "Backend API"
        API["🔧 NestJS REST API"]
    end

    PAGES --> COMP
    PAGES --> COMPOSE
    COMPOSE --> STATE
    ROUTER --> PAGES
    PAGES --> SERVICES
    SERVICES --> HTTP
    HTTP -->|"REST + JWT"| API

    style PAGES fill:#E8F5E9,stroke:#2E7D32
    style COMP fill:#E8F5E9,stroke:#2E7D32
    style ROUTER fill:#FFF8E1,stroke:#F57F17
    style COMPOSE fill:#FFF8E1,stroke:#F57F17
    style STATE fill:#FFF8E1,stroke:#F57F17
    style SERVICES fill:#E3F2FD,stroke:#1565C0
    style HTTP fill:#E3F2FD,stroke:#1565C0
    style API fill:#FFF3E0,stroke:#E65100
